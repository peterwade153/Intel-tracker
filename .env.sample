# Airflow
AIRFLOW__API_AUTH__JWT_SECRET=change-me-jwt-secret
AIRFLOW__CORE__FERNET_KEY=change-me-fernet-key
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=ai_tracker

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Tracker database
TRACKER_DATABASE_URL=postgresql+psycopg://airflow:airflow@postgres:5432/ai_tracker

# Ollama (local embedding service)
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: override defaults below
# TRACKER_SQL_DIR=/opt/airflow/sql
# TRACKER_ASSET_SCHEMA=public
# TRACKER_RAW_AI_EVENTS_TABLE=raw_events
# AIRFLOW_SCRAPING_POOL_NAME=web_scraping_pool
# AIRFLOW_SCRAPING_POOL_SLOTS=3
# AIRFLOW_SCRAPING_POOL_DESCRIPTION=Outbound scraping and API requests